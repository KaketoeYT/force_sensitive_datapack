{
  "type": "origins:multiple",

  "shake":{
    "type": "origins:shaking"
  },

	"shader":{
		"type": "origins:shader",
		"toggleable": false,
		"shader": "minecraft:shaders/post/blur.json"
	},

  "overlay":{
	"type": "origins:overlay",
    "texture": "minecraft:test1",
    "strength": 1.0,
