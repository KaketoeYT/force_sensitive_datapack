{
    "type": "origins:multiple",
    "force":{
        "type":"origins:action_over_time",
        "interval": 1,
        "entity_action":{
            "type": "execute_command",
            "command": "function force:targeting"
        }
    },

    "glowing":{
        "type":"entity_glow",
            "use_teams": false,
            "red": 0.0,
            "green": 0.75,
            "blue": 1.0,

        "entity_condition": {
            "type": "origins:nbt",
            "nbt": "{Tags: ['target']}"
        }
    }
}