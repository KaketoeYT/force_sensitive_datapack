  "slow":{
    "type": "origins:active_self",
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:swing_hand",
          "hand": "MAIN_HAND"
        },
        {
          "type": "origins:execute_command",
          "command": "effect give @n[tag=target] minecraft:slowness 5 3 true"
        },
        {
          "type": "origins:execute_command",
          "command": "power grant @n[tag=target] force:slow_effects"
        },
        {
          "type": "origins:execute_command",
          "command": "function force:sounds/sound_force_slow"
        },
        {
            "type": "origins:execute_command",
            "command":"execute as @a at @s positioned ^ ^ ^6 if entity @n[distance=..5, type=!minecraft:arrow, type=!minecraft:item_frame] run resource change @s force:force_bar_bar -300"
        }
