{
    "type": "apoli:multiple",

    "mainhand": {
        "type": "apoli:active_self",
        "condition": {
            "type": "apoli:equipped_item",
            "equipment_slot": "mainhand",
            "item_condition": {
                "type": "apoli:custom_data",
                "nbt": "{saber_type:'shoto'}"
            }
        },
        "entity_action": {
            "type": "apoli:execute_command",
            "command": "function force:saber/shoto/toggle {hand:'mainhand'}"
        },
        "key": {
            "key": "key.use",
            "continuous": false
        }
    },

    "offhand": {
        "type": "apoli:active_self",
        "condition": {
            "type": "apoli:equipped_item",
            "equipment_slot": "offhand",
            "item_condition": {
                "type": "apoli:custom_data",
                "nbt": "{saber_type:'shoto'}"
            }
        },
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "function force:saber/shoto/toggle {hand:'offhand'}"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "execute if items entity @s weapon.offhand *[minecraft:custom_data~{on:1b}] run resource set @s force:saber/combos/fighter_bar 0"
                }
            ]
        },
        "key": {
            "key": "key.use",
            "continuous": false
        }
    }
}