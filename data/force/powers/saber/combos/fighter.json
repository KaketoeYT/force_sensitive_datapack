                    "item_condition": {
                        "type": "origins:empty"
                    }
                }
            ]
        }
    },

    "bar": {
        "type": "origins:resource",
        "min": 0,
        "max": 7,
        "hud_render": {
            "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_points_01.png",
            "bar_index": 4,
            "icon_index": 1,
            "should_render": true,
            "order": 3,
            "condition": {
                "type": "apoli:power_active",
                "power": "force:saber/combos/fighter_validate"
            }
        }
    },

    "timer": {
        "type": "origins:resource",
        "min": 0,
        "max": 100,
        "start_value": 0,
        "min_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:change_resource",
                    "resource": "force:saber/combos/fighter_bar",
                    "operation": "set",
                    "change": 0
                },
                {
                    "type": "origins:execute_command",
                    "command": "function force:saber/combos/fx/fx_winddown"
                }
            ]
        }
    },

    "combo_timeout": {
        "type": "origins:action_over_time",
        "interval": 1,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "force:saber/combos/fighter_bar",
                    "comparison": ">",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "force:saber/combos/fighter_timer",
                    "comparison": ">",
                    "compare_to": 0
                }
            ]
        },
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "force:saber/combos/fighter_timer",
            "change": -1
        }
    },

    "combo_refresh": {
        "type": "origins:action_on_hit",
