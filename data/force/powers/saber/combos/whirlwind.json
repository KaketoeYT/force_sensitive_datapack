            "should_render": false
        }
    },

    "spin_ccw": {
        "type": "origins:resource",
        "min": 0,
        "max": 30,
        "hud_render": {
            "should_render": false
        }
    },

    "spin_cw_tick": {
        "type": "origins:action_over_time",
        "interval": 1,
        "condition": {
            "type": "origins:resource",
            "resource": "force:saber/combos/whirlwind_spin_cw",
            "comparison": ">",
            "compare_to": 0
        },
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:execute_command",
                    "command": "tp @s ~ ~ ~ ~30 ~"
                },
                {
                    "type": "origins:change_resource",
                    "resource": "force:saber/combos/whirlwind_spin_cw",
                    "operation": "add",
                    "change": -1
                }
            ]
        }
    },

