{
    "type": "origins:multiple",

    "bar":{
        "type": "origins:resource",
        "min": 0,
        "max": 2,
        "hud_render": {
            "should_render": true
        }
    },

    "fist_buff":{
        "type": "origins:modify_damage_dealt",
        "modifier": {
            "operation": "set_base",
            "amount": 6
        }
    },

    "per_attack":{
        "type": "origins:action_on_hit",
        "bientity_action": {
            "type": "origins:actor_action",
            "action":{
                "type": "origins:change_resource",
                "resource": "force:saber_combos/fighter_bar",
                "operation":"add",
                "change": 1
            }
        },
        "bientity_condition": {
            "type": "origins:actor_condition",
            "condition": {
                "type": "origins:equipped_item",
                "equipment_slot": "mainhand",
                "item_condition": {
                    "type": "origins:empty"
                }
            }
        }
    },

    "1_2_attack":{
        "type":"origins:action_on_hit",
        "bientity_condition": {
            "type":"origins:and",
            "conditions": [
                {
                    "type": "origins:actor_condition",
                    "condition": {
                        "type": "origins:resource",
                        "resource": "force:saber_combos/fighter_bar",
                        "comparison": "<",
                        "compare_to": 2
                    }
                },
                {
                    "type": "origins:actor_condition",
                    "condition": {
                        "type": "origins:equipped_item",
                        "equipment_slot": "mainhand",
                        "item_condition": {
                            "type": "origins:empty"
                        }
                    }
                }
            ] 
        },
        "bientity_action": {
            "type":"origins:and",
            "actions":[
                {
                    "type": "origins:add_velocity",
                    "z": 0.25
                },
                {
                    "type": "origins:target_action",
                    "action": {
                        "type": "origins:damage",
                        "amount": 6.5,
                        "damage_type": "minecraft:player_attack"
                    }
                },
                {
                    "type": "origins:actor_action",
                    "action": {
                        "type": "execute_command",
                        "command": "say first or second attack"
                    }
                }
            ]
        }
    },

    "3_attack":{
        "type": "origins:action_on_hit",
        "bientity_condition": {
            "type":"origins:and",
            "conditions": [
                {
                    "type": "origins:actor_condition",
                    "condition": {
                        "type": "origins:resource",
                        "resource": "force:saber_combos/fighter_bar",
                        "comparison": ">=",
                        "compare_to": 2
                    }
                },
                {
                    "type": "origins:actor_condition",
                    "condition": {
                        "type": "origins:equipped_item",
                        "equipment_slot": "mainhand",
                        "item_condition": {
                            "type": "origins:empty"
                        }
                    }
                }
            ]
        },
        "bientity_action": {
            "type":"origins:and",
            "actions": [
                {
                    "type": "origins:actor_action",
                    "action": {
                        "type": "origins:change_resource",
                        "resource": "force:saber_combos/fighter_bar",
                        "operation":"set",
                        "change": 0
                    }
                },
                {
                    "type": "origins:target_action",
                    "action": {
                        "type": "origins:damage",
                        "amount": 10.5,
                        "damage_type": "minecraft:player_attack"
                    }
                },
                {
                    "type": "origins:actor_action",
                    "action": {
                        "type": "origins:delay",
                        "ticks": 3,
                        "action": {
                            "type": "origins:swing_hand",
                            "hand": "OFF_HAND"
                        }
                    }
                },
                {
                    "type": "origins:actor_action",
                    "action": {
                        "type": "execute_command",
                        "command": "say third attack"
                    }
                }
            ]
        }
    }
}