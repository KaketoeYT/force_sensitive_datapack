{
    "type": "origins:multiple",
    "bar":{
        "type": "origins:resource",
        "start_value": 1000,
        "min": 0,
        "max": 1000,
        "hud_render": {
            "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_01.png",
            "bar_index": 12,
            "icon_index": 1,
            "should_render": true,
            "order": 1
        },
        "min_action": {
            "type": "origins:heal",
            "amount": 6
        }
    },

    "active_refill": {
        "type": "origins:action_on_hit",
        "bientity_action": {
            "type": "origins:actor_action",
            "action": {
                "type": "origins:execute_command",
                "command": "resource change @s force:force_bar_bar 50"
            }
        }
    },

    "passive_refill": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:execute_command",
            "command": "resource change @s force:force_bar_bar 1"
        },
        "interval": 2
    },

    "respawn_refill": {
        "type": "origins:action_on_death",
        "bientity_action": {
            "type": "origins:target_action",
            "action": {
                "type": "origins:execute_command",
                "command": "resource set @s force:force_bar_bar 1000"
            }
        }
    },

    "sleep_refill":{
        "type": "origins:action_on_wake_up",
        "entity_action": {
            "type": "origins:execute_command",
            "command": "resource set @s force:force_bar_bar 1000"
        }
    },

    "max_refill_debug":{
        "type": "origins:active_self",
                "entity_action": {
            "type": "origins:execute_command",
            "command": "resource set @s force:force_bar_bar 1000"
        },

        "cooldown": 20,
        "hud_render": {
        "should_render": true
        },
        "key": {
        "key": "key.hotbar.9",
        "continuous": false
        }
    }
}